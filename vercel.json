{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/revenue-desk-demo",               "destination": "/revenuedeskos",        "statusCode": 308 },
    { "source": "/revenue-desk-demo/:path*",        "destination": "/revenuedeskos/:path*", "statusCode": 308 },
    { "source": "/archiveos-demo",                  "destination": "/archiveos",            "statusCode": 308 },
    { "source": "/archiveos-demo/:path*",           "destination": "/archiveos/:path*",     "statusCode": 308 },
    { "source": "/church-os-demo",                  "destination": "/churchos",             "statusCode": 308 },
    { "source": "/church-os-demo/:path*",           "destination": "/churchos/:path*",      "statusCode": 308 },
    { "source": "/inventory-os-demo",               "destination": "/inventoryos",          "statusCode": 308 },
    { "source": "/inventory-os-demo/:path*",        "destination": "/inventoryos/:path*",   "statusCode": 308 },
    { "source": "/runneros-demo",                   "destination": "/runneros",             "statusCode": 308 },
    { "source": "/runneros-demo/:path*",            "destination": "/runneros/:path*",      "statusCode": 308 },
    { "source": "/cookbook-os-demo",                "destination": "/cookbookos",           "statusCode": 308 },
    { "source": "/cookbook-os-demo/:path*",         "destination": "/cookbookos/:path*",    "statusCode": 308 },
    { "source": "/cookbookos_showcase",             "destination": "/cookbookos",           "statusCode": 308 },
    { "source": "/cookbookos_showcase/:path*",      "destination": "/cookbookos/:path*",    "statusCode": 308 },
    { "source": "/demos/revenue-desk-demo",        "destination": "/revenuedeskos",        "statusCode": 308 },
    { "source": "/demos/revenue-desk-demo/:path*", "destination": "/revenuedeskos/:path*", "statusCode": 308 },
    { "source": "/demos/archiveos-demo",           "destination": "/archiveos",            "statusCode": 308 },
    { "source": "/demos/archiveos-demo/:path*",    "destination": "/archiveos/:path*",     "statusCode": 308 },
    { "source": "/demos/church-os-demo",           "destination": "/churchos",             "statusCode": 308 },
    { "source": "/demos/church-os-demo/:path*",    "destination": "/churchos/:path*",      "statusCode": 308 },
    { "source": "/demos/inventory-os-demo",        "destination": "/inventoryos",          "statusCode": 308 },
    { "source": "/demos/inventory-os-demo/:path*", "destination": "/inventoryos/:path*",   "statusCode": 308 },
    { "source": "/demos/runneros-demo",            "destination": "/runneros",             "statusCode": 308 },
    { "source": "/demos/runneros-demo/:path*",     "destination": "/runneros/:path*",      "statusCode": 308 },
    { "source": "/demos/cookbook-os-demo",         "destination": "/cookbookos",           "statusCode": 308 },
    { "source": "/demos/cookbook-os-demo/:path*",  "destination": "/cookbookos/:path*",    "statusCode": 308 }
  ],
  "rewrites": [
    { "source": "/revenuedeskos",          "destination": "/demos/revenue-desk-demo" },
    { "source": "/revenuedeskos/:path*",   "destination": "/demos/revenue-desk-demo/:path*" },
    { "source": "/archiveos",              "destination": "/demos/archiveos-demo" },
    { "source": "/archiveos/:path*",       "destination": "/demos/archiveos-demo/:path*" },
    { "source": "/churchos",               "destination": "/demos/church-os-demo" },
    { "source": "/churchos/:path*",        "destination": "/demos/church-os-demo/:path*" },
    { "source": "/inventoryos",            "destination": "/demos/inventory-os-demo" },
    { "source": "/inventoryos/:path*",     "destination": "/demos/inventory-os-demo/:path*" },
    { "source": "/runneros",               "destination": "/demos/runneros-demo" },
    { "source": "/runneros/:path*",        "destination": "/demos/runneros-demo/:path*" },
    { "source": "/cookbookos",             "destination": "/demos/cookbook-os-demo" },
    { "source": "/cookbookos/:path*",      "destination": "/demos/cookbook-os-demo/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
